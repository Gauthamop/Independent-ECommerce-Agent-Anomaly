# Copy this file to ".env" (same folder) and put your real key after the equals sign.
# ".env" is git-ignored. Never commit a real key, and never paste it into a chat.
GROQ_API_KEY=
# Optional: which Groq model to use (default: openai/gpt-oss-120b). Models differ per account;
# list yours with the Groq console or client.models.list().
# GROQ_MODEL=openai/gpt-oss-120b
